PORT=5000
NODE_ENV=development

# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb://127.0.0.1:27017/goswift

# Long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Comma separated frontend origins allowed by CORS (use * only in development)
ALLOWED_ORIGINS=http://localhost:5173

# true = only logged-in drivers/admins may send "busLocation" over the socket
# (the current frontend does not send a token yet, so keep false until you add it)
REQUIRE_SOCKET_AUTH=false

# Used by `npm run seed`
SEED_ADMIN_EMAIL=admin@goswift.local
SEED_ADMIN_PASSWORD=Admin@12345

# Reports: minutes ahead of UTC for "per day" grouping (330 = India)
REPORT_TZ_OFFSET_MIN=330

# Optional e-mail alerts (also needs `npm install`, nodemailer is in package.json).
# Leave SMTP_HOST empty to use in-app notifications only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=GoSwift <no-reply@example.com>
